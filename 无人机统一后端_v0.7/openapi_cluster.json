      "get": {
        "summary": "当前实现版本与运行线程健康状态，需Bearer鉴权",
        "responses": {
          "200": {
            "description": "仿真运行健康，可仍处于保护模式"
          },
          "401": {
            "description": "未鉴权"
          },
          "503": {
            "description": "工作线程、成员或状态新鲜度异常"
          }
        }
      }
    }
