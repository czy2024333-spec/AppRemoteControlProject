<?xml version="1.0" encoding="utf-8"?>
<!-- 允许明文 TCP 连接局域网 MQTT Broker（如 tcp://192.168.1.10:1883） -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
