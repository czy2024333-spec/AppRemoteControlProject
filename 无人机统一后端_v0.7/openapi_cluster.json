  "components": {
    "securitySchemes": {
      "sourceToken": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ClusterRequest": {
        "type": "object",
        "required": [
          "cluster_id",
          "cluster_session_id",
          "request_id",
          "sequence",
          "sent_at_ms",
          "ttl_ms"
        ],
        "properties": {
          "cluster_id": {
            "type": "string"
          },
          "cluster_session_id": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "selection_id": {
            "type": "string"
          },
          "device_id": {
            "type": "string"
          },
          "group_id": {
            "type": "string"
          },
          "task_id": {
            "type": "string"
          },
          "contract_version": {
            "type": "string"
          },
          "sequence": {
            "type": "integer",
            "minimum": 0
          },
          "sent_at_ms": {
            "type": "number"
          },
          "ttl_ms": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 500
          },
          "user_initiated": {
            "type": "boolean"
          },
          "takeover": {
            "type": "boolean"
          },
          "target_kind": {
            "type": "string",
            "enum": [
              "single",
              "group",
              "cluster"
            ]
          },
          "member_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "online": {
            "type": "boolean"
          },
          "member": {
            "type": "object"
          },
          "parameters": {
            "type": "object"
          },
          "commands": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "device_id",
                "path",
                "body"
              ],
              "properties": {
                "device_id": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "body": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
