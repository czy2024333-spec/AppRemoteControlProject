              "schema": {
                "$ref": "#/components/schemas/ClusterRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok/data；dispatch须检查逐成员results"
          },
          "400": {
            "description": "参数错误"
          },
          "403": {
            "description": "权限不足"
          },
          "409": {
            "description": "过期、冲突、失联或旧选择"
          },
          "501": {
            "description": "协同算法未实现"
